# Environment variables (Explicitly excluded for secrets hygiene)
.env
.env.*
!.env.example

# Python cache & bytecode
__pycache__/
*.py[cod]
*.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local databases & checkpoints (No PII at rest)
data/*.sqlite
data/*.db
*.sqlite
*.sqlite-journal
traces/test_*

# IDE / Editor configuration
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini
