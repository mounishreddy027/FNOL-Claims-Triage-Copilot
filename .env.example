# Google Gemini API Configuration (Exclusively approved LLM provider)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# You can set either GOOGLE_API_KEY or GEMINI_API_KEY (both are supported):
GOOGLE_API_KEY=AIzaSy...your_gemini_api_key_here
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Gemini Model Selection:
# Options: gemini-2.0-flash (default, fastest), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL_NAME=gemini-2.0-flash

# Arize Phoenix Observability
PHOENIX_PORT=6006
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
